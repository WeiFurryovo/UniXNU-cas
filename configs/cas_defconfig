# Single-core continuous bring-up. New successful observations never stop execution.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
# Original ApplePMGR nub (UniXNU-sheng ShengPlatformPower via scripts/build-platform-power.py);
# AMFI panics "No PMGR?" without it. Hook from sheng-platform-power.patch in the SM8250 series.
CONFIG_XNU_SHENG_PMGR=y
# UFS root, the UniXNU-alioth chain: ShengUfs (FFT-infra SM8250 fork) publishes the SHNGROOT
# windows of userdata; every block read is checked against the owner-signed OS and SystemOS
# policies (scripts/build-owner-root-policies.py) through the verified Virtio bundle's hooks;
# SystemOS is union-mounted; the payload's Data seed is published by RamBlock and mounted at
# /private/var before launchd.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block-verified-bundle/libVirtioMmioBlock.a"
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# Volume UUID of the Data seed (3 GiB container) from .github/workflows/data-seed.yml run 41294881443
# (cas-data-3g.dbr f4c8f3c4..., grown by seed-data-grow.py); every seed build makes a new one.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="28D3F7FE-7309-438E-B4A6-C02EAE41DE09"
# boot_progress_poll for NativeUfs when CONFIG_XNU_BOOT_PROGRESS is off (scripts/build-link-stubs.py); with it
# on, the force-loaded libBootProgress.a defines the name and the stub member is never pulled.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/link-stubs/libLinkStubs.a"
# CONFIG_XNU_NATIVE_ADRENO is not set

# Successful observations log and continue; optional GUI/storage experiments remain off.
# On-screen stage log and console (scripts/build-boot-progress.py): m2b-002 hung with nothing on screen.
CONFIG_XNU_BOOT_PROGRESS=y
# CPU-presented display on the firmware frame buffer (GopFramebuffer NativeLegacyDisplay, scripts/build-gop-legacy-display.py),
# started by the offline-legacy-* boot arguments in board.toml, as on UniXNU-umi.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
