+; scanout_b3a8: plane 0 is XRGB2101010 (R at bit 20, G at bit 10, B at bit 0).
+; p is width, height, sourceWords, destinationWords; sourceWords is the alpha plane's byte stride, not stride / 4.
+; XR codes clip to [384,894], then (code - 384 + 1) >> 1 is exactly ((code - 384) * 255 + 255) / 510.
+; The alpha plane is not read; the scanout is opaque. No transfer function or table is applied.
+;   kernel void scanout_b3a8(device const uint *src [[buffer(0)]], device uint *dst [[buffer(1)]], constant uint4 &p [[buffer(3)]],
+;                            uint2 gid [[thread_position_in_grid]])
+define void @scanout_b3a8(ptr addrspace(1) noundef readonly "air-buffer-no-alias" %src, ptr addrspace(1) noundef "air-buffer-no-alias" %dst, ptr addrspace(2) noundef readonly align 16 dereferenceable(16) "air-buffer-no-alias" %p, <2 x i32> noundef %gid) local_unnamed_addr #0 {
+entry:
+  %w = load i32, ptr addrspace(2) %p, align 16
+  %ph = getelementptr inbounds i32, ptr addrspace(2) %p, i64 1
+  %h = load i32, ptr addrspace(2) %ph, align 4
+  %x = extractelement <2 x i32> %gid, i64 0
+  %y = extractelement <2 x i32> %gid, i64 1
+  %inx = icmp ult i32 %x, %w
+  %iny = icmp ult i32 %y, %h
+  %in = and i1 %inx, %iny
+  br i1 %in, label %body, label %done
+
+body:
+  %pss = getelementptr inbounds i32, ptr addrspace(2) %p, i64 2
+  %ss = load i32, ptr addrspace(2) %pss, align 8
+  %pds = getelementptr inbounds i32, ptr addrspace(2) %p, i64 3
+  %ds = load i32, ptr addrspace(2) %pds, align 4
+  %x64 = zext i32 %x to i64
+  %y64 = zext i32 %y to i64
+  %ss64 = zext i32 %ss to i64
+  %srow = mul i64 %y64, %ss64
+  %si = add i64 %srow, %x64
+  %sp = getelementptr inbounds i32, ptr addrspace(1) %src, i64 %si
+  %v = load i32, ptr addrspace(1) %sp, align 4
+  %rshift = lshr i32 %v, 20
+  %gshift = lshr i32 %v, 10
+  %r = and i32 %rshift, 1023
+  %g = and i32 %gshift, 1023
+  %b = and i32 %v, 1023
+  %rlo = icmp ult i32 %r, 384
+  %glo = icmp ult i32 %g, 384
+  %blo = icmp ult i32 %b, 384
+  %rfloor = select i1 %rlo, i32 384, i32 %r
+  %gfloor = select i1 %glo, i32 384, i32 %g
+  %bfloor = select i1 %blo, i32 384, i32 %b
+  %rhi = icmp ugt i32 %rfloor, 894
+  %ghi = icmp ugt i32 %gfloor, 894
+  %bhi = icmp ugt i32 %bfloor, 894
+  %rclip = select i1 %rhi, i32 894, i32 %rfloor
+  %gclip = select i1 %ghi, i32 894, i32 %gfloor
+  %bclip = select i1 %bhi, i32 894, i32 %bfloor
+  %rzero = sub i32 %rclip, 384
+  %gzero = sub i32 %gclip, 384
+  %bzero = sub i32 %bclip, 384
+  %rround = add i32 %rzero, 1
+  %ground = add i32 %gzero, 1
+  %bround = add i32 %bzero, 1
+  %rv = lshr i32 %rround, 1
+  %gv = lshr i32 %ground, 1
+  %bv = lshr i32 %bround, 1
