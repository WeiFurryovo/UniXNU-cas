new file mode 100644
index 0000000000000000000000000000000000000000..d6d7c9827094a085c37f6bb9decec784a62ecabb
--- /dev/null
+++ b/bridge/scanout_client_host.mm
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: MIT
+// Runs the REAL Client and Presenter against instrumented Objective-C Metal stand-ins. No GPU/pixel correctness claim.
+// clang++ -std=c++17 -fobjc-arc -Wall -Wextra -Werror -framework Foundation -framework Metal scanout_client_host.mm -o scanout-client-host
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <sys/mman.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <initializer_list>
+#include "../GpuScanoutClient.h"
+
+static unsigned checks;
+static void check(bool value, const char *name) {
+    ++checks;
+    if (!value) {std::fprintf(stderr, "FAIL: %s\n", name); std::exit(1);}
+}
+
+struct MockState {
+    unsigned imports = 0, commits = 0, waits = 0, encodings = 0;
+    unsigned failImport = 0;
+    bool failEncoder = false;
+    MTLCommandBufferStatus result = MTLCommandBufferStatusCompleted;
+    uint32_t params[4] = {};
+    __weak id target = nil, source = nil, commands = nil;
+};
+static MockState *active;
+
+@interface ScanoutMockBuffer : NSObject
+@property(nonatomic, readonly) void *contents;
+@property(nonatomic, readonly) NSUInteger length;
+- (instancetype)initWithBytes:(void *)bytes length:(NSUInteger)length;
+@end
+@implementation ScanoutMockBuffer
+- (instancetype)initWithBytes:(void *)bytes length:(NSUInteger)length {
+    if ((self = [super init])) {_contents = bytes; _length = length;}
+    return self;
+}
+@end
+
+@interface ScanoutMockPipeline : NSObject
+@property(nonatomic, readonly) NSUInteger maxTotalThreadsPerThreadgroup;
+@end
+@implementation ScanoutMockPipeline
+- (NSUInteger)maxTotalThreadsPerThreadgroup {return 128;}
+@end
+
+@interface ScanoutMockLibrary : NSObject
+- (id)newFunctionWithName:(NSString *)name;
+@end
+@implementation ScanoutMockLibrary
+- (id)newFunctionWithName:(NSString *)name {(void)name; return [NSObject new];}
+@end
+
+extern "C" const void *nmb_scanout_convert_air(size_t *length) {
+    static const uint32_t sentinel = 0;
+    *length = sizeof sentinel;
+    return &sentinel;
+}
+extern "C" id native_bridge_metal_library_with_air(const void *bytes, size_t length) {
+    (void)bytes; (void)length;
+    return [ScanoutMockLibrary new];
+}
+
+@interface ScanoutMockEncoder : NSObject
+- (void)setComputePipelineState:(id)state;
+- (void)setBuffer:(id)buffer offset:(NSUInteger)offset atIndex:(NSUInteger)index;
+- (void)setBytes:(const void *)bytes length:(NSUInteger)length atIndex:(NSUInteger)index;
+- (void)dispatchThreadgroups:(MTLSize)groups threadsPerThreadgroup:(MTLSize)threads;
+- (void)endEncoding;
+@end
+@implementation ScanoutMockEncoder
+- (void)setComputePipelineState:(id)state {(void)state;}
+- (void)setBuffer:(id)buffer offset:(NSUInteger)offset atIndex:(NSUInteger)index {(void)buffer; (void)offset; (void)index;}
+- (void)setBytes:(const void *)bytes length:(NSUInteger)length atIndex:(NSUInteger)index {
+    check(length == sizeof active->params && index == 3, "16-byte parameter ABI");
+    std::memcpy(active->params, bytes, length);
+}
+- (void)dispatchThreadgroups:(MTLSize)groups threadsPerThreadgroup:(MTLSize)threads {
+    check(groups.width && groups.height && threads.width == 16 && threads.height == 8, "bounded dispatch geometry");
+}
+- (void)endEncoding {++active->encodings;}
+@end
+
+@interface ScanoutMockCommands : NSObject
+@property(nonatomic, readonly) MTLCommandBufferStatus status;
+- (id)computeCommandEncoder;
+- (void)commit;
+- (void)waitUntilCompleted;
+@end
+@implementation ScanoutMockCommands
+- (id)computeCommandEncoder {return active->failEncoder ? nil : [ScanoutMockEncoder new];}
+- (void)commit {
+    ++active->commits;
+    check(active->source != nil && active->target != nil && active->commands != nil, "imports and commands live at commit");
+}
+- (void)waitUntilCompleted {++active->waits;}
+- (MTLCommandBufferStatus)status {return active->result;}
+@end
+
+@interface ScanoutMockQueue : NSObject
+- (id)commandBuffer;
+@end
+@implementation ScanoutMockQueue
+- (id)commandBuffer {
+    ScanoutMockCommands *commands = [ScanoutMockCommands new];
+    active->commands = commands;
+    return commands;
+}
+@end
+
+@interface ScanoutMockDevice : NSObject
+- (id)newCommandQueue;
+- (id)newBufferWithBytesNoCopy:(void *)bytes length:(NSUInteger)length options:(MTLResourceOptions)options
+                 deallocator:(void (^)(void *, NSUInteger))deallocator;
+- (id)newComputePipelineStateWithFunction:(id)function error:(NSError **)error;
+@end
+@implementation ScanoutMockDevice
+- (id)newCommandQueue {return [ScanoutMockQueue new];}
+- (id)newBufferWithBytesNoCopy:(void *)bytes length:(NSUInteger)length options:(MTLResourceOptions)options
+                 deallocator:(void (^)(void *, NSUInteger))deallocator {
+    (void)options; (void)deallocator;
+    ++active->imports;
+    if (active->imports == active->failImport) return nil;
+    ScanoutMockBuffer *buffer = [[ScanoutMockBuffer alloc] initWithBytes:bytes length:length];
+    if (active->imports == 1) active->target = buffer; else active->source = buffer;
+    return buffer;
+}
+- (id)newComputePipelineStateWithFunction:(id)function error:(NSError **)error {
+    (void)function; (void)error;
+    return [ScanoutMockPipeline new];
+}
+@end
+
+struct Harness {
+    MockState metal;
+    gpuscanout::Client client;
+    gpuscanout::Stats stats = {};
+    NGPMode mode = {NGP_VERSION, NGP_BGRX8888, 4, 2, 16, 32};
+    NGPSwap swap = {};
+    void *target = nullptr, *source = nullptr;
+    size_t targetBytes = 0, sourceBytes = 0;
+    uint64_t mappedBytes = 0;
+    unsigned armCalls = 0, completeCalls = 0, waitCalls = 0;
+    uint32_t completionStatus = 0;
+    int armResult = 0;
+    bool opened = false;
+    explicit Harness(bool mapShort = false) {
+        active = &metal;
+        const size_t page = (size_t)getpagesize();
+        targetBytes = page; sourceBytes = page * 2;
+        target = mmap(nullptr, targetBytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        source = mmap(nullptr, sourceBytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        check(target != MAP_FAILED && source != MAP_FAILED, "allocate stand-in pages");
+        swap = {42, (uint64_t)(uintptr_t)source, sourceBytes, 4, 4, 2, NGP_B3A8_XR_OPAQUE, 0};
+        mappedBytes = mapShort ? mode.bytes : targetBytes;
+        opened = client.open((id<MTLDevice>)[ScanoutMockDevice new], {this, call, map, nullptr}, &stats);
+    }
+    // Held cases keep backing too: the test never unmaps memory while asserting the real Presenter's references are still live.
+    static int call(void *context, uint32_t method, const void *input, size_t inSize, void *output, size_t outSize) {
+        Harness &h = *(Harness *)context;
+        switch (method) {
+            case NGP_METHOD_MODE:
+                check(!input && !inSize && outSize == sizeof h.mode, "mode wire ABI");
+                std::memcpy(output, &h.mode, sizeof h.mode); return 0;
+            case NGP_METHOD_WAIT_SWAP:
+                ++h.waitCalls;
+                check(inSize == sizeof(NGPWait) && outSize == sizeof h.swap, "wait wire ABI");
+                std::memcpy(output, &h.swap, sizeof h.swap); return 0;
+            case NGP_METHOD_ARM_SWAP:
+                ++h.armCalls;
+                check(inSize == sizeof(NGPArm) && !output && !outSize, "ARM wire ABI");
+                check(((const NGPArm *)input)->sequence == h.swap.sequence, "ARM sequence binding");
+                check(h.metal.encodings == 1 && !h.metal.commits, "ARM after encoding before commit");
+                check(h.metal.source != nil && h.metal.target != nil && h.metal.commands != nil, "all resources retained before ARM");
+                return h.armResult;
+            case NGP_METHOD_COMPLETE_SWAP:
+                ++h.completeCalls;
+                check(inSize == sizeof(NGPComplete), "completion ABI");
+                check(((const NGPComplete *)input)->sequence == h.swap.sequence, "completion sequence");
+                h.completionStatus = ((const NGPComplete *)input)->status;
+                if (!h.completionStatus && h.swap.format == NGP_B3A8_XR_OPAQUE)
+                    check(h.armCalls == 1 && !h.armResult && h.metal.result == MTLCommandBufferStatusCompleted, "success requires ARM and Completed");
+                return 0;
+            default: check(false, "unexpected method"); return -1;
+        }
+    }
+    static int map(void *context, uint64_t *address, uint64_t *length) {
+        Harness &h = *(Harness *)context;
+        *address = (uint64_t)(uintptr_t)h.target; *length = h.mappedBytes; return 0;
+    }
+};
+
+static void heldCase(int armResult, MTLCommandBufferStatus result, const char *name) {
+    Harness h;
+    check(h.opened, "open held-case client");
+    h.armResult = armResult; h.metal.result = result;
+    @autoreleasepool {check(!h.client.serveOne(1), "uncertain state stops serving");}
+    check(h.armCalls == 1 && !h.completeCalls, "held never calls COMPLETE");
+    check(h.metal.commits == (armResult ? 0u : 1u), "ARM rejection never commits");
+    check(h.metal.source != nil && h.metal.target != nil && h.metal.commands != nil, "held owns imports and command after pool drain");
+    check(h.stats.held == 1 && !h.stats.completed && !h.stats.rejected && h.stats.lastResult == gpupresent::kHeld, "held counters are distinct");
+    h.swap.format = NGP_BGRX8888;
+    check(!h.client.serveOne(1) && h.waitCalls == 1 && !h.completeCalls, "held refuses later legacy frame without waiting");
+    std::printf("ok %s\n", name);
+}
+
+int main() {
+    @autoreleasepool {
+        {
+            Harness h(true);
+            check(!h.opened && h.stats.step == 3 && !h.metal.imports, "short scanout map rejected before import");
+        }
+        for (uint32_t refusal : {0xe00002c7u /* Unsupported */, 0xe00002d5u /* Busy */}) {
+            Harness h;
+            check(h.opened, "open explicitly refused ARM client");
+            h.armResult = (int)refusal;
+            @autoreleasepool {check(h.client.serveOne(1), "known unarmed rejection safely retires");}
+            check(h.armCalls == 1 && !h.metal.commits && h.completeCalls == 1 && h.completionStatus, "known ARM refusal never commits and sends error COMPLETE");
+            check(h.stats.rejected == 1 && !h.stats.held && !h.stats.armed && !h.stats.completed, "known ARM refusal counters");
+            check(h.metal.source == nil && h.metal.commands == nil, "known unarmed rejection releases temporary resources");
+        }
+        heldCase((int)0xe00002bcu, MTLCommandBufferStatusCompleted, "unknown ARM error: no commit or COMPLETE");
+        heldCase((int)0xe00002c2u, MTLCommandBufferStatusCompleted, "ambiguous duplicate ARM: no commit or COMPLETE");
+        heldCase((int)0xe00002d6u, MTLCommandBufferStatusCompleted, "lost ARM reply: retain without commit or COMPLETE");
+        heldCase(0, MTLCommandBufferStatusError, "post-ARM Error holds resources");
+        heldCase(0, MTLCommandBufferStatusCommitted, "post-ARM nonterminal status holds resources");
+        {
+            Harness h;
+            check(h.opened, "open successful client");
+            // Match the known all-zero XR source's black opaque output; this mock does not implement or validate the shader.
+            uint32_t *pixels = (uint32_t *)h.target;
+            for (unsigned i = 0; i < 8; ++i) pixels[i] = 0xff000000u;
+            @autoreleasepool {check(h.client.serveOne(1), "Completed retires successfully");}
+            check(h.armCalls == 1 && h.completeCalls == 1 && !h.completionStatus, "completed sends exactly one success");
