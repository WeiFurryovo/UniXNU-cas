diff --git a/bridge/scanout_layout_host.cpp b/bridge/scanout_layout_host.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..db17b992c61124278d2416b1a29543abe8986637
--- /dev/null
+++ b/bridge/scanout_layout_host.cpp
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+// Pure layout checks: no Metal SDK, driver or device is involved.
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <initializer_list>
+#include "../GpuScanoutLayout.h"
+
+static unsigned checks;
+static void check(bool value, const char *name) {
+    ++checks;
+    if (!value) {std::fprintf(stderr, "FAIL: %s\n", name); std::exit(1);}
+}
+
+int main() {
+    namespace layout = gpupresent::layout;
+    uint64_t value = 0;
+    check(layout::multiply(0, UINT64_MAX, value) && value == 0, "multiply zero");
+    check(layout::multiply(UINT64_MAX, 1, value) && value == UINT64_MAX, "multiply maximum");
+    check(!layout::multiply(UINT64_MAX, 2, value), "multiply overflow");
+    check(layout::add(UINT64_MAX - 1, 1, value) && value == UINT64_MAX, "add maximum");
+    check(!layout::add(UINT64_MAX, 1, value), "add overflow");
+    check(!layout::round(0, 4096, value), "zero import");
+    check(!layout::round(4096, 0, value), "zero page");
+    check(!layout::round(4096, 4095, value), "non-power-of-two page");
+    check(!layout::round(UINT64_MAX, 4096, value), "page rounding overflow");
+    for (uint64_t page : {uint64_t(4096), uint64_t(16384)}) {
+        const uintptr_t address = (uintptr_t)(page * 2);
+        check(layout::round(page, page, value) && value == page, "exact page stays exact");
+        check(layout::round(page + 1, page, value) && value == page * 2, "partial page rounds");
+        check(layout::import((void *)address, page, page), "aligned mapped page");
+        check(!layout::import(nullptr, page, page), "null import");
+        check(!layout::import((void *)(address + 4), page, page), "unaligned import");
+        check(!layout::import((void *)address, page - 1, page), "short non-page mapped extent");
+        check(!layout::import((void *)(UINTPTR_MAX & ~(uintptr_t)(page - 1)), page, page), "address wrapping");
+        // Rounded length alone is not mapping evidence: these are independent valid-byte and VM-coverage checks.
+        const uint64_t validBytes = page + 4, shortMapping = validBytes;
+        check(layout::round(validBytes, page, value) && value > shortMapping, "reject rounded target beyond real map");
+        check(value <= page * 2 && layout::import((void *)address, value, page), "accept explicitly covered rounded target");
+        check(!layout::import((void *)address, validBytes, page), "never enlarge source wire extent implicitly");
+    }
+    check(layout::dimensions(1, 1), "minimal dimensions");
+    check(layout::dimensions(16384, 16384), "maximum dimensions");
+    check(!layout::dimensions(0, 1) && !layout::dimensions(1, 0), "zero dimensions");
+    check(!layout::dimensions(16385, 1) && !layout::dimensions(1, 16385), "dimension limit");
+    check(layout::rows(2, 2, 16, 4, 24), "valid final row without padding");
+    check(!layout::rows(2, 2, 16, 4, 23), "short visible final row");
+    check(layout::rows(1, 1, UINT64_MAX, 4, 4), "one-row unused pitch does not overflow");
+    check(!layout::rows(2, 3, UINT64_MAX, 4, UINT64_MAX), "row offset multiplication overflow");
+    check(!layout::rows(2, 2, UINT64_MAX - 3, 4, UINT64_MAX), "last row addition overflow");
+    check(!layout::rows(16384, 1, UINT64_MAX, UINT64_MAX, UINT64_MAX), "pixel width multiplication overflow");
+    check(!layout::rows(1, 1, 4, 0, 4), "zero bytes per pixel");
+    check(!layout::rows(2, 1, 7, 4, 8), "short row pitch");
+    check(layout::wordPitch(uint64_t(UINT32_MAX) * 4), "maximum representable shader word pitch");
+    check(!layout::wordPitch((uint64_t(UINT32_MAX) + 1) * 4), "shader pitch truncation");
+    check(!layout::wordPitch(6), "unaligned shader word pitch");
+    const uint64_t fullExtent = 12732672;
+    check(layout::b3a8(1080, 2340, 1088, fullExtent), "real 1080x2340 alpha pitch 1088 extent");
+    check(!layout::b3a8(1080, 2340, 1088, fullExtent - 1), "missing final alpha byte");
+    check(!layout::b3a8(1080, 2340, 1088, 1088ull * 2340 * 4), "colour only does not cover full b3a8");
+    check(!layout::b3a8(1080, 2340, 1079, fullExtent), "b3a8 short alpha pitch");
+    check(!layout::b3a8(1080, 2340, uint64_t(UINT32_MAX) + 1, UINT64_MAX), "b3a8 sourceWords cannot truncate");
+    check(layout::b3a8(1, 1, 1, 4097), "b3a8 alpha follows 4096-aligned colour");
+    check(!layout::b3a8(1, 1, 1, 4096), "b3a8 still requires alpha although shader skips it");
+    check(!layout::b3a8(0, 1, 1, 8192), "b3a8 zero dimensions");
+    std::printf("PASS: %u checked scanout layout cases (4 KiB and 16 KiB pages)\n", checks);
+}
