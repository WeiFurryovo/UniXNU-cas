+            const uint32_t *want = (const uint32_t *)(reference + (size_t)y * ds * 4);
+            for (uint32_t x = 0; x < w; ++x) {
+                if (out[x] != want[x] || out[x] != expected_pixel(in[x]) || (out[x] >> 24) != 255) {
+                    fprintf(stderr, "FAIL %s (%u,%u) src=%08x actual=%08x reference=%08x\n",
+                            name, x, y, in[x], out[x], want[x]); exit(1);
+                }
+            }
+        }
+        require(memcmp(dst.data, reference, dst.bytes) == 0, "destination pixels, row padding and tail canary");
+    }
+    printf("ok %s: %ux%u sourceWords=%u destinationWords=%u extent=%zu alpha variations=2\n",
+           name, w, h, ss, ds, sourceBytes);
+    free(reference); free(saved); release(dst); release(src);
+}
+int main(void) {
+    no_access();
+    run_case(1, 1, 1, 1, 0, "single pixel");
+    run_case(1024, 4, 1032, 1033, 1, "all 1024 codes in each channel and grey");
+    run_case(225, 15, 233, 237, 2, "all 3375 edge-code RGB combinations");
+    run_case(257, 17, 263, 269, 3, "mixed channel ramp and high X bits");
+    run_case(17, 11, 23, 25, 0, "partial 16x8 workgroups and odd padded pitches");
+    run_case(31, 9, 31, 31, 0, "tight rows and workgroup tail");
+    run_case(1080, 2340, 1088, 1088, 0, "cas full frame");
+#ifdef REFERENCE_HEADER
+    puts("PASS: actual scanout_b3a8 IR equals original NativeLegacyRequest.h and rational XR oracle; alpha never read");
+#else
+    puts("PASS: actual scanout_b3a8 IR equals rational XR oracle; alpha never read (original CPU header not supplied)");
+#endif
+    return 0;
+}
+'''
+
+WRAPPER = r'''
+define void @scanout_b3a8_host(ptr %src, ptr %dst, ptr %p, i32 %x, i32 %y) {
+  %gx = insertelement <2 x i32> poison, i32 %x, i32 0
+  %gid = insertelement <2 x i32> %gx, i32 %y, i32 1
+  call void @scanout_b3a8(ptr %src, ptr %dst, ptr %p, <2 x i32> %gid)
+  ret void
+}
+'''
+
+
+def run(command, **kwargs):
+    print('+ ' + shlex.join(str(arg) for arg in command), flush=True)
+    return subprocess.run(command, check=True, **kwargs)
+
+
+def check_metadata(source):
+    nodes = dict(re.findall(r'^!(\d+) = (.+)$', source, re.MULTILINE))
+    kernels = re.search(r'^!air.kernel = !\{([^}]+)\}$', source, re.MULTILINE)
+    if not kernels:
+        raise SystemExit('missing AIR kernel registry')
+    entries = [nodes[n] for n in re.findall(r'!(\d+)', kernels[1])]
+    entry = [e for e in entries if 'ptr @scanout_b3a8,' in e]
+    if len(entry) != 1:
+        raise SystemExit('scanout_b3a8 must have one independent AIR registration')
+    ids = re.findall(r'!(\d+)', entry[0])
+    args = [nodes[n] for n in re.findall(r'!(\d+)', nodes[ids[-1]])]
+    bindings = [(0, 0, 1, 'src'), (1, 1, 1, 'dst'), (2, 3, 2, 'p')]
+    if len(args) != 4:
+        raise SystemExit('scanout_b3a8 must have three buffers and one uint2 gid')
+    for arg, (index, binding, address_space, name) in zip(args, bindings):
+        required = [f'!{{i32 {index}, !"air.buffer"', f'!"air.location_index", i32 {binding}, i32 1',
+                    f'!"air.address_space", i32 {address_space}', f'!"air.arg_name", !"{name}"']
+        if any(part not in arg for part in required):
+            raise SystemExit(f'invalid b3a8 argument metadata: {arg}')
+    if '!"air.buffer_size", i32 16' not in args[2] or '!"air.arg_type_align_size", i32 16' not in args[2]:
+        raise SystemExit('scanout_b3a8 params must retain the 16-byte ABI')
+    if not all(part in args[3] for part in ['!{i32 3, !"air.thread_position_in_grid"', '!"uint2"']):
+        raise SystemExit('scanout_b3a8 requires uint2 thread_position_in_grid')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--reference-header', type=Path, help='existing NativeLegacyRequest.h; never copied into the public test')
+    parser.add_argument('--clang', default=shutil.which('clang'))
+    parser.add_argument('--llvm-as', default=shutil.which('llvm-as'))
+    parser.add_argument('--opt', default=shutil.which('opt'))
+    args = parser.parse_args()
+    if not all([args.clang, args.llvm_as, args.opt]):
+        parser.error('clang, llvm-as and opt are required')
+    if args.reference_header and not args.reference_header.is_file():
+        parser.error('--reference-header must name an existing header')
+    shader = Path(__file__).resolve().parents[1] / 'shaders/scanout_convert.ll'
+    source = shader.read_text()
+    check_metadata(source)
+    function = re.search(r'^define void @scanout_b3a8\([^\n]+\) local_unnamed_addr #(\d+) \{\n.*?^\}', source, re.MULTILINE | re.DOTALL)
+    if not function:
+        raise SystemExit('missing actual scanout_b3a8 function')
+    attributes = re.search(r'^attributes #' + function[1] + r' = \{([^}]+)\}', source, re.MULTILINE)
+    if not attributes:
+        raise SystemExit('missing kernel attributes')
+    # Preserve every instruction, predicate and constant from the actual kernel.
+    host_function = re.sub(r' addrspace\([12]\)', '', function[0])
+    print('shader SHA256 ' + hashlib.sha256(shader.read_bytes()).hexdigest(), flush=True)
+    reference_flags = []
+    if args.reference_header:
+        header = args.reference_header.resolve()
+        print('reference SHA256 ' + hashlib.sha256(header.read_bytes()).hexdigest(), flush=True)
+        reference_flags = [f'-DREFERENCE_HEADER="{header}"']
+    for tool in [args.clang, args.llvm_as, args.opt]:
+        version = subprocess.check_output([tool, '--version'], text=True)
+        print(version.splitlines()[0], flush=True)
+    with tempfile.TemporaryDirectory(prefix='scanout-b3a8-') as temporary:
+        out = Path(temporary)
+        # Verify the complete original AIR module, including its metadata and all old kernels.
+        run([args.llvm_as, shader, '-o', out / 'scanout.air'])
+        # Upstream LLVM has no AIR backend; override only the target while verifying the original module.
+        triple = subprocess.check_output([args.clang, '-dumpmachine'], text=True).strip()
+        run([args.opt, '-mtriple=' + triple, '-passes=verify', '-disable-output', out / 'scanout.air'])
+        target_ir = subprocess.check_output([args.clang, '-S', '-emit-llvm', '-x', 'c', '-', '-o', '-'], input='', text=True)
+        target = '\n'.join(line for line in target_ir.splitlines() if line.startswith('target '))
+        harness = out / 'check.c'
+        harness.write_text(HARNESS)
+        for mode, flags in [('O0', ['-O0']), ('O2', ['-O2']),
+                            ('asan-ubsan', ['-O1', '-g', '-fsanitize=address,undefined', '-fno-sanitize-recover=all', '-fno-omit-frame-pointer'])]:
+            # ASan marks are test instrumentation, not a replacement of the AIR algorithm.
+            extra = ' sanitize_address' if mode == 'asan-ubsan' else ''
+            host = out / (mode + '.ll')
+            host.write_text(target + '\n' + host_function + '\n' + WRAPPER + '\nattributes #' + function[1] +
+                            ' = {' + attributes[1] + extra + '}\n')
+            run([args.llvm_as, host, '-o', out / (mode + '.bc')])
+            run([args.opt, '-passes=verify', '-disable-output', out / (mode + '.bc')])
+            obj = out / (mode + '.o')
+            run([args.clang, *flags, '-c', host, '-o', obj])
+            executable = out / mode
+            run([args.clang, '-std=c11', '-Wall', '-Wextra', '-Werror', *flags, *reference_flags, harness, obj, '-o', executable])
+            run([executable])
+        print('PASS: complete AIR verifies; actual kernel passes O0, O2 and ASan/UBSan host runs', flush=True)
+
+
+if __name__ == '__main__':
+    main()
