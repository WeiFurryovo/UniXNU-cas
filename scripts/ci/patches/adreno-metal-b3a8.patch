+#if __has_feature(address_sanitizer)
+#include <sanitizer/asan_interface.h>
+#define POISON(p, n) __asan_poison_memory_region((p), (n))
+#define UNPOISON(p, n) __asan_unpoison_memory_region((p), (n))
+#else
+#define POISON(p, n) ((void)0)
+#define UNPOISON(p, n) ((void)0)
+#endif
+#ifdef REFERENCE_HEADER
+#include REFERENCE_HEADER
+#endif
+
+extern void scanout_b3a8_host(const void *, void *, const void *, uint32_t, uint32_t);
+struct params {uint32_t width, height, sourceWords, destinationWords;};
+_Static_assert(sizeof(struct params) == 16, "scanout parameter ABI");
+
+static void require(int ok, const char *what) {
+    if (!ok) {fprintf(stderr, "FAIL: %s\n", what); exit(1);}
+}
+static size_t round_up(size_t n, size_t align) {return (n + align - 1) & ~(align - 1);}
+static uint32_t random_word(uint32_t *state) {
+    *state ^= *state << 13; *state ^= *state >> 17; *state ^= *state << 5;
+    return *state;
+}
+// Independent rational XR oracle; the code under test remains the LLVM function.
+static uint32_t xr(uint32_t code) {
+    if (code <= 384) return 0;
+    if (code >= 894) return 255;
+    return ((code - 384) * 255 + 255) / 510;
+}
+static uint32_t expected_pixel(uint32_t v) {
+    return 0xff000000u | xr((v >> 20) & 1023) << 16 | xr((v >> 10) & 1023) << 8 | xr(v & 1023);
