new file mode 100644
index 0000000000000000000000000000000000000000..5743670841b156a8b1c9673f22d6b5b2bd4fbd53
--- /dev/null
+++ b/GpuScanoutLayout.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+// Checked byte extents for no-copy scanout imports. b3a8 stride is the A8 plane's pitch, not the colour pitch.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+namespace gpupresent {
+namespace layout {
+
+inline bool multiply(uint64_t a, uint64_t b, uint64_t &out) {
+    if (b && a > UINT64_MAX / b) return false;
+    out = a * b;
+    return true;
+}
+inline bool add(uint64_t a, uint64_t b, uint64_t &out) {
+    if (a > UINT64_MAX - b) return false;
+    out = a + b;
+    return true;
+}
+inline bool round(uint64_t bytes, uint64_t page, uint64_t &out) {
+    uint64_t n;
+    if (!bytes || !page || (page & (page - 1)) || !add(bytes, page - 1, n)) return false;
+    out = n & ~(page - 1);
+    return true;
+}
+inline bool dimensions(uint64_t width, uint64_t height) {
+    return width && height && width <= 16384 && height <= 16384;
+}
+inline bool import(const void *base, uint64_t bytes, uint64_t page) {
+    const uintptr_t address = (uintptr_t)base;
+    return address && page && !(page & (page - 1)) && !(address & (page - 1)) &&
+           bytes && bytes <= SIZE_MAX && bytes <= UINTPTR_MAX && !(bytes & (page - 1)) &&
+           address <= UINTPTR_MAX - bytes;
+}
+inline bool rows(uint64_t width, uint64_t height, uint64_t stride, uint64_t bytesPerPixel, uint64_t bytes) {
+    uint64_t row, preceding, extent;
+    // Padding after the final visible row is not accessed by the row copy or compute paths.
+    return dimensions(width, height) && bytesPerPixel && multiply(width, bytesPerPixel, row) && stride >= row &&
+           multiply(stride, height - 1, preceding) && add(preceding, row, extent) && extent <= bytes;
+}
+inline bool b3a8(uint64_t width, uint64_t height, uint64_t stride, uint64_t bytes) {
+    uint64_t colourStride, colour, alpha, alphaBytes, extent;
+    return dimensions(width, height) && stride >= width && stride <= UINT32_MAX &&
+           multiply(stride, 4, colourStride) && multiply(colourStride, height, colour) &&
+           round(colour, 4096, alpha) && multiply(stride, height, alphaBytes) &&
+           add(alpha, alphaBytes, extent) && extent <= bytes;
+}
+inline bool wordPitch(uint64_t stride) { return !(stride & 3) && stride / 4 <= UINT32_MAX; }
+
+} // namespace layout
+} // namespace gpupresent
